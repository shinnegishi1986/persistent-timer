        account_settings(user)

    def render_admin():
        st.title("Administration / 管理")
        admin_page(user)

    pages = [
        st.Page(
            render_timers,
            title="Timers / タイマー",
            url_path="timers",
            default=True,
        ),
        st.Page(
            render_editor,
            title="Create & edit / 作成・編集",
            url_path="timer-editor",
        ),
        st.Page(
            render_journal,
            title="Journal / 日記",
            url_path="journal",
        ),
        st.Page(
            render_csv,
            title="CSV / 入出力",
