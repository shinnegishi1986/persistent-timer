def duration_text(seconds):
    seconds = max(0, int(seconds))
    days, remainder = divmod(seconds, 86400)
    hours, remainder = divmod(remainder, 3600)
    minutes, seconds = divmod(remainder, 60)
    return f"{days}d {hours:02d}:{minutes:02d}:{seconds:02d}"


@st.fragment(run_every="1s")
def timer_dashboard(user_id):
    timers = user_timers(user_id)
    status_filter = st.selectbox(
        "Filter / 表示",
        ["All / すべて", "Current / 進行中", "Future / 予定", "Past / 終了"],
    )
    by_id = {timer["id"]: timer for timer in timers}
    visible = [
        timer for timer in timers
        if status_filter == "All / すべて" or timer_status(timer) == status_filter
    ]
    if not visible:
        st.info("No timers / タイマーがありません。")
        return

    # A stable preorder keeps parents above children without recursive rendering.
    children = {}
    for timer in timers:
        children.setdefault(timer["parent_id"], []).append(timer)

    ordered = []
    stack = [(timer, 0) for timer in reversed(children.get(None, []))]
    visited = set()
    while stack:
        timer, depth = stack.pop()
        if timer["id"] in visited:
            continue
        visited.add(timer["id"])
        ordered.append((timer, depth))
        stack.extend(
            (child, depth + 1)
            for child in reversed(children.get(timer["id"], []))
        )

    visible_ids = {timer["id"] for timer in visible}
    for timer, depth in ordered:
        if timer["id"] not in visible_ids:
            continue
        now = utc_now()
        start, end = parse_stamp(timer["starts_at"]), parse_stamp(timer["ends_at"])
        with st.container(border=True):
            prefix = ("↳ " * min(depth, 6)) if depth else ""
            st.subheader(f"{prefix}{timer['title']}")
            st.caption(timer_status(timer))
            if timer["parent_id"] in by_id:
                st.caption(f"Parent / 親: {by_id[timer['parent_id']]['title']}")
            if timer["description"]:
                st.text(timer["description"])
            st.caption(
                f"{local_text(timer['starts_at'])} → {local_text(timer['ends_at'])}"
            )
            if now < start:
                st.metric("Starts in / 開始まで", duration_text((start - now).total_seconds()))
            elif now < end:
                st.metric("Remaining / 残り", duration_text((end - now).total_seconds()))
            else:
                st.metric("Finished ago / 終了から", duration_text((now - end).total_seconds()))
            progress = (now - start).total_seconds() / (end - start).total_seconds()
            st.progress(min(1.0, max(0.0, progress)))


